// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  // Extensionless imports so Next.js (Turbopack) can resolve the generated .ts files.
  importFileExtension = ""
}

// The connection URL lives in prisma.config.ts (CLI) and lib/prisma.js (runtime).
datasource db {
  provider = "sqlite"
}

model Entry {
  id String @id @default(uuid())
  Name String?
  First String?
  Last String?
  createdAt DateTime @default(now())
}
